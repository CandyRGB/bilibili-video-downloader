{
  "manifest_version": 3,
  "name": "B站视频下载器",
  "version": "1.0.0",
  "description": "在 B 站播放器里一键下载视频：支持 1080P+/4K 高清、音视频自动合并、分P 批量、仅下音频。",
  "minimum_chrome_version": "111",

  "permissions": ["storage"],

  "host_permissions": [
    "*://*.bilibili.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://www.bilibili.com/video/*",
        "*://www.bilibili.com/bangumi/play/*",
        "*://www.bilibili.com/list/*"
      ],
      "js": ["lib/fmp4-mux.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "B站视频下载器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
